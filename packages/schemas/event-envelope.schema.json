{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.example/schema/event-envelope.schema.json",
  "title": "GRIDWORKS versioned event envelope",
  "type": "object",
  "required": ["event_id", "event_type", "event_version", "occurred_at", "producer", "correlation_id", "payload"],
  "properties": {
    "event_id": {"$ref": "semantic-id.schema.json"},
    "event_type": {"$ref": "semantic-id.schema.json"},
    "event_version": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "semantic-id.schema.json"},
    "correlation_id": {"type": "string", "minLength": 1},
    "causation_id": {"type": "string"},
    "related_entity_ids": {"type": "array", "items": {"$ref": "semantic-id.schema.json"}},
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
