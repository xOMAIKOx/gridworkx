{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gridworks.example/schema/company-command.schema.json",
  "title":"GRIDWORKS company mutation contracts",
  "oneOf":[
    {"$ref":"#/$defs/companyCreate"},
    {"$ref":"#/$defs/groupCreate"},
    {"$ref":"#/$defs/ownershipTransfer"},
    {"$ref":"#/$defs/groupAssign"},
    {"$ref":"#/$defs/groupDetach"},
    {"$ref":"#/$defs/groupReassign"}
  ],
  "$defs":{
    "id":{"type":"string","minLength":1,"pattern":"^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9_-]*)+$"},
    "player":{"type":"object","required":["type","id"],"properties":{"type":{"const":"player"},"id":{"type":"string","pattern":"^player\\.[a-z0-9][a-z0-9_-]*$"}},"additionalProperties":false},
    "system":{"type":"object","required":["type","id"],"properties":{"type":{"const":"system"},"id":{"const":"principal.gridworks.system"}},"additionalProperties":false},
    "owner":{"oneOf":[{"$ref":"#/$defs/player"},{"$ref":"#/$defs/system"}]},
    "base":{"type":"object","required":["mutation_type","idempotency_key"],"properties":{"mutation_type":{"type":"string"},"idempotency_key":{"$ref":"#/$defs/id"}},"additionalProperties":false},
    "companyCreate":{"type":"object","required":["mutation_type","idempotency_key","company_type","name","owner"],"properties":{"mutation_type":{"const":"company.create"},"idempotency_key":{"$ref":"#/$defs/id"},"company_type":{"enum":["holding","operating","system"]},"name":{"type":"string","minLength":3,"maxLength":80},"owner":{"$ref":"#/$defs/owner"}},"additionalProperties":false},
    "groupCreate":{"type":"object","required":["mutation_type","idempotency_key","name","owner"],"properties":{"mutation_type":{"const":"group.create"},"idempotency_key":{"$ref":"#/$defs/id"},"name":{"type":"string","minLength":3,"maxLength":80},"owner":{"$ref":"#/$defs/owner"}},"additionalProperties":false},
    "ownershipTransfer":{"type":"object","required":["mutation_type","idempotency_key","entity_type","entity_id","from","to","share_bps"],"properties":{"mutation_type":{"const":"ownership.transfer"},"idempotency_key":{"$ref":"#/$defs/id"},"entity_type":{"enum":["company","group"]},"entity_id":{"$ref":"#/$defs/id"},"from":{"$ref":"#/$defs/owner"},"to":{"$ref":"#/$defs/owner"},"share_bps":{"type":"integer","minimum":1,"maximum":10000}},"additionalProperties":false},
    "groupAssign":{"type":"object","required":["mutation_type","idempotency_key","company_id","group_id"],"properties":{"mutation_type":{"const":"group.assign"},"idempotency_key":{"$ref":"#/$defs/id"},"company_id":{"$ref":"#/$defs/id"},"group_id":{"$ref":"#/$defs/id"}},"additionalProperties":false},
    "groupDetach":{"type":"object","required":["mutation_type","idempotency_key","company_id","group_id"],"properties":{"mutation_type":{"const":"group.detach"},"idempotency_key":{"$ref":"#/$defs/id"},"company_id":{"$ref":"#/$defs/id"},"group_id":{"$ref":"#/$defs/id"}},"additionalProperties":false},
    "groupReassign":{"type":"object","required":["mutation_type","idempotency_key","company_id","group_id"],"properties":{"mutation_type":{"const":"group.reassign"},"idempotency_key":{"$ref":"#/$defs/id"},"company_id":{"$ref":"#/$defs/id"},"group_id":{"$ref":"#/$defs/id"}},"additionalProperties":false}
  }
}
