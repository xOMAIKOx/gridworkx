{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gridworks.example/schema/company-command.schema.json",
  "title":"GRIDWORKS company mutation contracts",
  "type":"object",
  "required":["mutation_type","idempotency_key"],
  "properties":{"mutation_type":{"enum":["company.create","group.create","ownership.transfer","group.assign"]},"idempotency_key":{"type":"string","minLength":1,"pattern":"^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9_-]*)+$"},"company_id":{"type":"string"},"group_id":{"type":"string"},"name":{"type":"string","minLength":3,"maxLength":80},"owner":{"type":"object","required":["type","id"],"properties":{"type":{"enum":["player","system"]},"id":{"type":"string","minLength":1}},"additionalProperties":false},"share_bps":{"type":"integer","minimum":1,"maximum":9999}},
  "additionalProperties":false
}
