{
  "openapi": "3.1.0",
  "info": {
    "title": "GRIDWORKS API",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:18080"
    }
  ],
  "components": {
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "PlayerID": {
        "name": "player_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "CompanyID": {
        "name": "company_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Error": {
        "description": "Stable error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "request_id",
              "timestamp"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "timestamp": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "CompanyCreate": {
        "type": "object",
        "required": [
          "company_type",
          "name"
        ],
        "properties": {
          "company_type": {
            "enum": [
              "holding",
              "operating"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          }
        },
        "additionalProperties": false
      },
      "GroupCreate": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 80
          }
        },
        "additionalProperties": false
      },
      "ProfilePatch": {
        "type": "object",
        "properties": {
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "bio": {
            "type": "string",
            "maxLength": 1000
          },
          "locale": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "visibility": {
            "enum": [
              "public",
              "private"
            ]
          },
          "dm_policy": {
            "enum": [
              "everyone",
              "nobody"
            ]
          },
          "discoverable": {
            "type": "boolean"
          },
          "notification_preferences": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Version": {
        "type": "object",
        "required": [
          "api_version",
          "version"
        ],
        "properties": {
          "api_version": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "GuestResponse": {
        "type": "object",
        "required": [
          "account_id",
          "player_id",
          "session_id",
          "expires_at",
          "profile",
          "replay"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "player_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "profile": {
            "type": "object"
          },
          "session_token": {
            "type": "string"
          },
          "replay": {
            "type": "boolean"
          },
          "credential_unavailable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "required": [
          "account_id",
          "player_id",
          "status",
          "profile"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "player_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "profile": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "PublicPlayer": {
        "type": "object",
        "required": [
          "player_id",
          "handle",
          "display_name",
          "locale",
          "visibility",
          "discoverable"
        ],
        "properties": {
          "player_id": {
            "type": "string"
          },
          "handle": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "avatar_asset_id": {
            "type": "string"
          },
          "bio": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          },
          "discoverable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "CreatedEntity": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PublicCompany": {
        "type": "object",
        "required": [
          "company_id",
          "name",
          "visibility"
        ],
        "properties": {
          "company_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "logo_asset_id": {
            "type": "string"
          },
          "industry_id": {
            "type": "string"
          },
          "headquarters_region_id": {
            "type": "string"
          },
          "visibility": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PlayerSkill": {
        "type": "object",
        "required": [
          "player_id",
          "skill_id",
          "cumulative_xp",
          "proficiency_bps",
          "progression_version"
        ],
        "properties": {
          "player_id": {
            "type": "string"
          },
          "skill_id": {
            "type": "string"
          },
          "cumulative_xp": {
            "type": "integer",
            "minimum": 0
          },
          "proficiency_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "progression_version": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "SkillsResponse": {
        "type": "object",
        "required": [
          "skills"
        ],
        "properties": {
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlayerSkill"
            }
          }
        },
        "additionalProperties": false
      },
      "ManagerSkill": {
        "type": "object",
        "required": [
          "skill_id",
          "proficiency_bps",
          "potential_bps"
        ],
        "properties": {
          "skill_id": {
            "type": "string"
          },
          "proficiency_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "potential_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "additionalProperties": false
      },
      "Manager": {
        "type": "object",
        "required": [
          "manager_id",
          "display_name",
          "rarity",
          "specialization_id",
          "total_xp",
          "level",
          "skills",
          "traits",
          "workload_bps",
          "fatigue_bps",
          "morale_bps",
          "status",
          "active_employment",
          "potential_visible"
        ],
        "properties": {
          "manager_id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "rarity": {
            "enum": [
              "Bronze",
              "Silver",
              "Gold",
              "Platinum"
            ]
          },
          "specialization_id": {
            "type": "string"
          },
          "total_xp": {
            "type": "integer",
            "minimum": 0
          },
          "level": {
            "type": "integer",
            "minimum": 1
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ManagerSkill"
            }
          },
          "traits": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workload_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "fatigue_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "morale_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "status": {
            "enum": [
              "Active",
              "Inactive"
            ]
          },
          "active_employment": {
            "type": "boolean"
          },
          "active_facility_id": {
            "type": "string"
          },
          "potential_visible": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "ManagersResponse": {
        "type": "object",
        "required": [
          "managers"
        ],
        "properties": {
          "managers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Manager"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "paths": {
