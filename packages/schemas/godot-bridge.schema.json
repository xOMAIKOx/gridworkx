{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridworks.example/schema/godot-bridge.schema.json",
  "title": "GRIDWORKS Godot Rust bridge envelope",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/failure"}
  ],
  "$defs": {
    "version": {"type": "string", "minLength": 1},
    "success": {
      "type": "object",
      "required": ["ok", "bridge_version", "schema_version", "rules_version", "operation", "result"],
      "properties": {
        "ok": {"const": true},
        "bridge_version": {"$ref": "#/$defs/version"},
        "schema_version": {"$ref": "#/$defs/version"},
        "rules_version": {"$ref": "#/$defs/version"},
        "operation": {"type": "string", "minLength": 1},
        "result": {"type": "object"}
      },
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "required": ["ok", "bridge_version", "schema_version", "rules_version", "operation", "error"],
      "properties": {
        "ok": {"const": false},
        "bridge_version": {"$ref": "#/$defs/version"},
        "schema_version": {"$ref": "#/$defs/version"},
        "rules_version": {"$ref": "#/$defs/version"},
        "operation": {"type": "string", "minLength": 1},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
