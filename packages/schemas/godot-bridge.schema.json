{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gridworks.example/schema/godot-bridge.schema.json",
  "title":"GRIDWORKS Godot Rust bridge envelope",
  "oneOf":[
    {"$ref":"#/$defs/success"},
    {"$ref":"#/$defs/failure"}
  ],
  "$defs":{
    "success":{"type":"object","required":["ok","operation","result"],"properties":{"ok":{"const":true},"operation":{"type":"string","minLength":1},"result":{"type":"object"}},"additionalProperties":false},
    "failure":{"type":"object","required":["ok","error"],"properties":{"ok":{"const":false},"error":{"type":"object","required":["code","message"],"properties":{"code":{"type":"string"},"message":{"type":"string"}},"additionalProperties":false}},"additionalProperties":false}
  }
}
